# =============================================================================
# apps/api/.env.example — copia a .env y ajusta valores.
# (Este archivo NUNCA contiene secretos reales: .env está gitignored.)
# =============================================================================

NODE_ENV=development
PORT=3000
# SQLite de la app (Prisma). Relativa = apps/api/prisma/.
DATABASE_URL="file:./dev.db"
# Secreto JWT (>= 16 chars). En producción es OBLIGATORIO.
JWT_SECRET="dev-secret-change-me-please-0123456789abcdef"

# ── [ Fuente de stats del ranking: games_mp.log del server IW4x ] ────────────
# Ruta al games_mp.log (barras normales; UNC permitidas):
# GAME_LOG_PATH=D:/Call of Duty 6/userraw/logs/games_mp.log
# Etiqueta de server para los eventos (IP LAN, no localhost):
# GAME_SERVER_ADDRESS=192.168.3.99:28961
# Ingesta casi en vivo (SYNC_INTERVAL_SECONDS tiene prioridad):
SYNC_INTERVAL_SECONDS=30
SYNC_INTERVAL_MINUTES=0

# ── [ Moderación NATIVA por RCON del server IW4x (sin IW4MAdmin) ] ───────────
# El panel habla DIRECTO con el server dedicado vía UDP Quake-rcon.
# Host/puerto UDP del server dedicado (los del server.cfg: net_port / bind):
RCON_HOST=127.0.0.1
RCON_PORT=28961
# El MISMO valor de `set rcon_password "..."` del server.cfg (línea ~48).
# SIN este valor la moderación nativa responde 503 MODERATION_NOT_CONFIGURED
# y el enforcer de tempbans/bans no arranca.
RCON_PASSWORD=
# Spacing mínimo entre comandos rcon (ms). El server descarta (throttle
# silencioso) si llegan a menos de rcon_timeout=100ms: 200 da margen.
RCON_SPACING_MS=200
# Timeout de respuesta por intento (ms). Las LECTURAS reintentan con backoff
# (el server a veces tarda >1s); las ESCRITURAS jamás se reintentan.
RCON_RESPONSE_TIMEOUT_MS=1200
# Intervalo del ENFORCER (ms): re-kickea guids con tempban/ban activos en
# NUESTRA DB (capa offline de los tempbans per-caso y bans emitidos offline).
RCON_ENFORCER_INTERVAL_MS=30000
# Path a userraw/bans.json del server para LISTAR los bans del juego en el
# panel (SOLO lectura; la escritura SIEMPRE vía rcon banClient/unbanClient).
# RCON_BANS_FILE=D:/Call of Duty 6/userraw/bans.json

# ── [ Panel admin de config del server (server.cfg) ] ────────────────────────
# SERVER_CFG_PATH=D:/Call of Duty 6/userraw/server.cfg
ALLOW_SERVER_CONTROL=1
# SERVER_RESTART_COMMAND=taskkill /F /IM iw4x.exe & timeout /t 2 & start "" /D "D:\Call of Duty 6" "D:\Call of Duty 6\DedicatedServer.bat"

# ── [ Cuentas admin / roles ] ────────────────────────────────────────────────
# Emails (coma) que reciben rol ADMIN al registrarse/loguear:
ADMIN_EMAILS=
# Admin por defecto del seed (solo si la tabla User está vacía):
ADMIN_NICK=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
SEED_DEFAULT_ADMIN=1

# ── [ Otros ] ────────────────────────────────────────────────────────────────
LINK_WINDOW_MINUTES=10
CORS_ORIGIN=http://localhost:5173
# Lista de servers para launcher/web (JSON):
SERVERS=[{"name":"LAN Server","address":"192.168.2.251:28960"},{"name":"Test Local","address":"192.168.3.99:28961","isDefault":true}]
# Raíz del cloud save por cuenta (default: apps/api/storage/profiles):
# PROFILE_STORAGE_DIR=C:/Users/josev/Documents/GitHub/iw4x-ranking/apps/api/storage/profiles

# ── [ DEPRECATED — bridge IW4MAdmin ELIMINADO ] ──────────────────────────────
# La moderación ya NO usa el webfront/SQLite de IW4MAdmin. Estas variables se
# conservan SOLO para dos usos residuales OPCIONALES de stats (NO moderación):
#   IW4MADMIN_DB_PATH: fuente alternativa de stats para el sync (better que no
#     usarla; la fuente real es GAME_LOG_PATH).
# ELIMINADAS (ya no se leen en ningún módulo vivo):
#   IW4MADMIN_WEBFRONT_URL  (el panel ya no consulta el webfront :1624)
#   IW4MADMIN_PENALTIES_DB_PATH (el historial vive en NUESTRA tabla Penalty)
#   IW4MADMIN_API_USER / IW4MADMIN_API_PASS (login por cookie del webfront)
