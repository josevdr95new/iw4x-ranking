{
  "name": "@iw4x-ranking/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "sync": "tsx src/scripts/run-sync.ts",
    "recompute:skill": "tsx src/scripts/recompute-skill.ts",
    "rebuild:aliases": "tsx src/scripts/rebuild-aliases.ts",
    "rebuild:identity": "tsx src/scripts/rebuild-identity.ts",
    "promote:admin": "tsx src/scripts/promote-admin.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "db:clean": "tsx scripts/clean-testdata.ts",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
