// Esquema de la base propia del ranking (SQLite vía Prisma).
// La base de IW4MAdmin NO se modela aquí: se lee read-only con better-sqlite3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  displayName  String
  /// Nick reservado: cleanName(displayName) en lowercase (strip códigos ^X).
  /// Único case-insensitive → 409 NICK_TAKEN si otra cuenta lo usa.
  /// Nullable solo por compatibilidad con filas previas a la migración;
  /// register/PATCH SIEMPRE lo escriben (seed: npm run rebuild:identity).
  displayNameNormalized String? @unique
  role         String        @default("USER") // USER | ADMIN (auto-grant vía ADMIN_EMAILS o script promote:admin)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  /// Marca de "cuarentena de identidad" (POST /api/identity/claim-fresh): la
  /// cuenta espera un guid NUEVO (p. ej. su guid.dat compartido fue subido a la
  /// nube desde varias cuentas y se quiere una identidad limpia). Mientras está
  /// seteada:
  ///  - el auto-link por sesión acepta un guid NUEVO aunque la cuenta ya tenga
  ///    guids viejos vinculados (los guids viejos siguen sin matchear: el flag
  ///    también limpia el PlaySession.guid colgante), y
  ///  - se auto-limpia al producirse ese link (one-shot).
  /// El usuario NUNCA se borra por esto; null = flujo normal.
  claimFreshAt DateTime?
  accountLinks AccountLink[]
  linkAttempts LinkAttempt[]
  identityAlerts IdentityAlert[]
  playSessions PlaySession[]
}

/// Intento de vinculación cuenta↔GUID (POST /api/link/start)
model LinkAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending | completed
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Jugador agregado desde IW4MAdmin o del games_mp.log (1 fila por NetworkId/GUID)
model Player {
  id            Int         @id @default(autoincrement())
  guid          String      @unique // NetworkId como string decimal (puede superar 2^53)
  name          String      @default("unknown") // último nombre conocido
  lastServer    String?     // servidor de la última conexión
  kills         Int         @default(0)
  deaths        Int         @default(0)
  kd            Float       @default(0)
  timePlayed    Int         @default(0) // segundos; con fuente log: suma de Session (abiertas: en curso, cap 4h)
  connections   Int         @default(0) // nº de conexiones/partidas (líneas J)
  skill         Float       @default(0) // valor EXPUESTO: skillElo + bonus de racha (ver docs/API.md "skill ELO")
  skillElo      Float       @default(0) // ELO base por eventos (0 = nunca procesado → se expone 1000 al inicializarse)
  headshots     Int         @default(0) // kills con hitloc head/helmet (fuente log)
  damageDealt   Int         @default(0) // daño total infligido (K + D, fuente log)
  damageTaken   Int         @default(0) // daño total recibido (K + D + world, fuente log)
  bestStreak    Int         @default(0) // mejor racha de kills sin morir (aprox: solo eventos K almacenados)
  teamkills     Int         @default(0) // kills con ateam == vteam (fuente log)
  matchesPlayed Int         @default(0) // mapas distintos con actividad (eventos + sesiones, aprox)
  /// true si el guid viene del rango dedicado a bots (0xb07…, mapeo de "botN").
  /// Set por la ingesta del log; bootstrap: npm run rebuild:aliases.
  isBot        Boolean     @default(false)
  /// Progresión parseada del cloud save (iw4x.stat) de la cuenta vinculada
  /// (link primario). Campo inválido según sanity → null individual;
  /// saveParsedAt null = nunca se parseó con éxito (ver docs/API.md).
  saveXp       Int?
  saveLevel    Int?
  savePrestige Int?
  saveParsedAt DateTime?
  firstConnection DateTime?
  lastConnection  DateTime?
  updatedAt       DateTime  @updatedAt
  accountLinks AccountLink[]
  sessions      Session[]
  aliases       PlayerAlias[]
}

/// Alias histórico de nombres por GUID (PCs compartidas / renombres).
/// Se puebla durante la ingesta del games_mp.log: cada línea J (guid+name) y
/// cada K (atacante y víctima con guid; la víctima "world" no tiene guid → skip).
/// @@unique([guid, name]) → una fila por par; occurrences cuenta apariciones.
model PlayerAlias {
  id          Int      @id @default(autoincrement())
  guid        String
  player      Player   @relation(fields: [guid], references: [guid], onDelete: Cascade)
  name        String   // nombre EXACTO visto en el log (con códigos de color ^X)
  firstSeenAt DateTime
  lastSeenAt  DateTime
  lastServer  String?  // etiqueta del server (GAME_SERVER_ADDRESS con fuente log)
  occurrences Int      @default(0) // nº de apariciones (J + K) acumuladas

  @@unique([guid, name])
  @@index([guid])
}

/// Alerta de identidad (anti-impersonación de nick registrado): alguien — un
/// guid NO vinculado al dueño — usó en el juego el displayName RESERVADO de una
/// cuenta web. Se crea/actualiza en la ingesta del log (línea J, rama connect).
/// Resolución MANUAL del admin (read/detect only en la ingesta):
///  - LINK_TO_OWNER → crea AccountLink(owner, guid) y marca RESOLVED_OWNER.
///  - DISMISS → marca DISMISSED (falso positivo o PC compartida declarada).
///  - El "castigo al impostor" NO es endpoint propio: el frontend compone
///    POST /api/admin/iam/penalty y luego resuelve con DISMISS.
/// Dedupe: una sola fila OPEN por (guid, ownerUserId); resuelta, un nuevo uso
/// del nick por el mismo guid crea una alerta nueva.
model IdentityAlert {
  id                       Int      @id @default(autoincrement())
  guid                     String   // guid que USÓ el nombre reservado
  name                     String   // nombre EXACTO visto en el log (última vez)
  ownerUserId              Int
  owner                    User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Snapshot (JSON array de guids) de los vínculos del dueño al detectarse.
  ownerLinkedGuidsSnapshot String?
  status                   String   @default("OPEN") // OPEN | RESOLVED_OWNER | RESOLVED_IMPOSTOR | DISMISSED
  firstSeenAt              DateTime
  lastSeenAt               DateTime
  occurrences              Int      @default(0)

  @@index([status, lastSeenAt])
}

/// Sesión de juego real: abre con J, cierra con Q (o ShutdownGame del mapa).
/// durationMin se fija al cerrar; una sesión abierta cuenta como en curso.
model Session {
  id          Int       @id @default(autoincrement())
  guid        String
  player      Player    @relation(fields: [guid], references: [guid], onDelete: Cascade)
  start       DateTime
  end         DateTime? // null = sesión abierta (en curso)
  durationMin Int       @default(0)
  map         String?   // mapa activo al abrirse la sesión
  gametype    String?

  @@index([guid, start])
}

/// Vinculación cuenta↔GUID MULTI (N GUIDs por cuenta, para PCs compartidas).
/// guid @unique → un GUID solo puede pertenecer a UNA cuenta (409 GUID_ALREADY_LINKED).
/// @@unique([userId, guid]) → sin filas duplicadas por par.
model AccountLink {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guid      String   @unique
  player    Player   @relation(fields: [guid], references: [guid], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, guid])
  @@index([userId])
}

/// Evento individual de kill (para perfil: historial reciente y series temporales).
/// Solo se almacenan K con víctima válida (los world/suicide solo alimentan
/// agregados del Player: deaths/damageTaken). Los D nunca se almacenan (bloat):
/// solo alimentan damageDealt/damageTaken.
model KillEvent {
  id         Int      @id @default(autoincrement())
  originGuid String
  targetGuid String
  isKill     Boolean  @default(true) // false = evento no letal en IW4MAdmin
  damage     Int      @default(0)
  weapon     String?  // arma base del log (ej. "mp5k_mp"); sin attachments
  /// Mod de la kill según el log (MOD_RIFLE_BULLET, MOD_MELEE, MOD_HEAD_SHOT...).
  /// MOD_MELEE = cuchillada (venga del cuchillo o de golpear con el arma en la
  /// mano: así lo cuenta el juego). Null en eventos de la fuente IW4MAdmin
  /// (su reader no lo importa) y en eventos previos a esta columna.
  mod        String?
  hitloc     String?  // zona del impacto (head, chest, torso_lower, ...)
  headshot   Boolean  @default(false) // hitloc en (head, helmet)
  isTeamkill Boolean  @default(false) // ateam == vteam
  map        String?  // mapa activo según InitGame del log (null si desconocido)
  gametype   String?  // modo activo según InitGame (ej. "war")
  server     String?  // etiqueta de servidor si la fuente la expone
  time       DateTime
  timeEpoch  Int // epoch en segundos
  // Flag de skill: true cuando este evento YA alimentó el ELO de los players.
  // El recompute FROM SCRATCH del bootstrap es automático: tras la migración
  // TODOS los eventos existentes quedan con false y el primer sync los procesa
  // en orden cronológico (timeEpoch ASC, id ASC).
  skillProcessed Boolean @default(false)

  @@index([originGuid, timeEpoch])
  @@index([targetGuid, timeEpoch])
  @@index([timeEpoch])
  @@index([weapon])
  @@index([map])
  @@index([skillProcessed, timeEpoch])
}

/// Bonus ELO de FIN DE PARTIDA (top-3 de kills entre humanos): 1º +15, 2º +10,
/// 3º +5 (constantes MATCH_BONUS en src/services/skill/elo.ts). Una fila por
/// jugador premiado y partida. Lo crea la ingesta del games_mp.log al detectar
/// ShutdownGame (partida ≥3 min de log, ≥2 humanos participantes, ≥5 kills para
/// calificar, bots excluidos). Consume `processSkillUpdates` igual que los
/// KillEvent (mismo flag + orden cronológico) → `npm run recompute:skill`
/// reproduce el bonus: mismo set de partidas → mismos eventos → mismo skill.
model MatchBonusEvent {
  id         Int     @id @default(autoincrement())
  guid       String // premiado (humano; formato Player.guid decimal)
  position   Int // 1 | 2 | 3
  delta      Float // ELO directo aplicado (+15/+10/+5)
  killsInMatch Int // kills del premiado en esa partida (≥5 para calificar)
  humansInMatch Int // humanos que participaron en la partida (≥2 requeridos)
  matchDurationSec Int // duración de la partida según prefijos de tiempo del log (≥180s)
  map        String?
  gametype   String?
  server     String?
  time       DateTime
  timeEpoch  Int // epoch en segundos (mismo criterio que KillEvent)
  // Flag de skill: mismo contrato que KillEvent.skillProcessed. Se procesa en
  // el MISMO stream cronológico (timeEpoch ASC, id ASC): el bonus de una
  // partida siempre ordena DESPUÉS de los kills de su partida (se crea al
  // detectar ShutdownGame) y ANTES de los kills de la partida siguiente.
  skillProcessed Boolean @default(false)

  @@index([guid, timeEpoch])
  @@index([skillProcessed, timeEpoch])
}

/// Penalidad de MODERACIÓN NATIVA (rcon IW4x, sin IW4MAdmin):
/// warn/kick/tempban/ban/unban emitidos desde el panel o el enforcer.
/// El guid del ofensor es decimal (formato Player.guid) o "botN" para bots
/// (por eso NO hay FK: un bot puede no tener fila en Player).
/// El BAN permanente del server vive en userraw/bans.json (vía rcon banClient);
/// esta tabla es el HISTORIAL + la capa offline (enforcer re-kickea al conectar).
model Penalty {
  id               Int       @id @default(autoincrement())
  offenderGuid     String    // GUID del ofensor (decimal del log, o "botN")
  offenderPlayerId Int?      // Player.id si existe la fila (soft reference)
  offenderName     String?   // snapshot del nombre visto al emitir
  punisherUserId   Int?      // User.id del admin (null = sistema/enforcer)
  punisherName     String?   // snapshot del display del admin
  type             String    // warn | kick | tempban | ban | unban
  reason           String?
  automated        Boolean   @default(false)
  source           String    @default("panel") // panel | enforcer
  active           Boolean   @default(true)    // false = expirada o revocada (unban)
  createdAt        DateTime  @default(now())
  /// Solo tempban (per-caso, en minutos). warn/ban/kick = null.
  expiresAt        DateTime?

  @@index([createdAt])
  @@index([offenderGuid, active])
  @@index([type, active, expiresAt])
}

/// Estado incremental por fuente (evita reimportar kill events ya conocidos)
model SyncState {
  id            Int       @id @default(autoincrement())
  source        String    @unique // ruta de la DB fuente
  lastKillEpoch Int       @default(0)
  lastRunAt     DateTime?
}

/// Configuración key-value persistente del panel (launcher-only, etc.).
/// value guarda JSON (string). key es la PK (única por definición).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Sesión de juego "launcher" (anti no-launcher): el launcher la crea al dar
/// JUGAR y la refresca en cada heartbeat (TTL DESLIZANTE, env
/// PLAY_SESSION_TTL_MIN, default 10 min). Una fila por cuenta (userId @unique,
/// refresh = upsert). `guid` queda null hasta que la ingesta hace el auto-link
/// del nick de la cuenta con el guid conectado al server. Expirada (expiresAt
/// <= now) NO cuenta como activa para el enforcer ni para el auto-link.
model PlaySession {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nick      String   // displayName de la cuenta al crear/refrescar
  guid      String?  // guid decimal (formato Player.guid) vinculado por auto-link
  lastSeen  DateTime // último heartbeat del launcher
  expiresAt DateTime // lastSeen + TTL
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Cursor de lectura del games_mp.log del servidor dedicado IW4x.
/// El offset de bytes avanza solo cuando las líneas están completas (tolera
/// escrituras a medias y truncados/rotaciones del archivo).
model LogIngestState {
  id              Int       @id @default(autoincrement())
  source          String    @unique // ruta absoluta del games_mp.log
  byteOffset      BigInt    @default(0) // bytes ya procesados
  linesParsed     Int       @default(0) // telemetría acumulada
  linesIgnored    Int       @default(0) // líneas no reconocidas (skip silencioso)
  currentMap      String?   // estado del parser: mapa activo (última InitGame con infostring)
  currentGametype String?   // estado del parser: modo activo
  lastRunAt       DateTime?
}

/// Auditoría de sincronizaciones
model SyncRun {
  id              Int       @id @default(autoincrement())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  ok              Boolean   @default(false)
  playersSynced   Int       @default(0)
  killEventsSynced Int      @default(0)
  warnings        String?
}
