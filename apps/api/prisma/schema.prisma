// Esquema de la base propia del ranking (SQLite vía Prisma).
// La base de IW4MAdmin NO se modela aquí: se lee read-only con better-sqlite3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  displayName  String
  role         String        @default("USER") // USER | ADMIN (auto-grant vía ADMIN_EMAILS o script promote:admin)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accountLinks AccountLink[]
  linkAttempts LinkAttempt[]
}

/// Intento de vinculación cuenta↔GUID (POST /api/link/start)
model LinkAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending | completed
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Jugador agregado desde IW4MAdmin o del games_mp.log (1 fila por NetworkId/GUID)
model Player {
  id            Int         @id @default(autoincrement())
  guid          String      @unique // NetworkId como string decimal (puede superar 2^53)
  name          String      @default("unknown") // último nombre conocido
  lastServer    String?     // servidor de la última conexión
  kills         Int         @default(0)
  deaths        Int         @default(0)
  kd            Float       @default(0)
  timePlayed    Int         @default(0) // segundos; con fuente log: suma de Session (abiertas: en curso, cap 4h)
  connections   Int         @default(0) // nº de conexiones/partidas (líneas J)
  skill         Float       @default(0) // heurística: kd*10 + kills/hora
  headshots     Int         @default(0) // kills con hitloc head/helmet (fuente log)
  damageDealt   Int         @default(0) // daño total infligido (K + D, fuente log)
  damageTaken   Int         @default(0) // daño total recibido (K + D + world, fuente log)
  bestStreak    Int         @default(0) // mejor racha de kills sin morir (aprox: solo eventos K almacenados)
  teamkills     Int         @default(0) // kills con ateam == vteam (fuente log)
  matchesPlayed Int         @default(0) // mapas distintos con actividad (eventos + sesiones, aprox)
  firstConnection DateTime?
  lastConnection  DateTime?
  updatedAt       DateTime  @updatedAt
  accountLinks AccountLink[]
  sessions      Session[]
}

/// Sesión de juego real: abre con J, cierra con Q (o ShutdownGame del mapa).
/// durationMin se fija al cerrar; una sesión abierta cuenta como en curso.
model Session {
  id          Int       @id @default(autoincrement())
  guid        String
  player      Player    @relation(fields: [guid], references: [guid], onDelete: Cascade)
  start       DateTime
  end         DateTime? // null = sesión abierta (en curso)
  durationMin Int       @default(0)
  map         String?   // mapa activo al abrirse la sesión
  gametype    String?

  @@index([guid, start])
}

/// Vinculación cuenta↔GUID MULTI (N GUIDs por cuenta, para PCs compartidas).
/// guid @unique → un GUID solo puede pertenecer a UNA cuenta (409 GUID_ALREADY_LINKED).
/// @@unique([userId, guid]) → sin filas duplicadas por par.
model AccountLink {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guid      String   @unique
  player    Player   @relation(fields: [guid], references: [guid], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, guid])
  @@index([userId])
}

/// Evento individual de kill (para perfil: historial reciente y series temporales).
/// Solo se almacenan K con víctima válida (los world/suicide solo alimentan
/// agregados del Player: deaths/damageTaken). Los D nunca se almacenan (bloat):
/// solo alimentan damageDealt/damageTaken.
model KillEvent {
  id         Int      @id @default(autoincrement())
  originGuid String
  targetGuid String
  isKill     Boolean  @default(true) // false = evento no letal en IW4MAdmin
  damage     Int      @default(0)
  weapon     String?  // arma base del log (ej. "mp5k_mp"); sin attachments
  hitloc     String?  // zona del impacto (head, chest, torso_lower, ...)
  headshot   Boolean  @default(false) // hitloc en (head, helmet)
  isTeamkill Boolean  @default(false) // ateam == vteam
  map        String?  // mapa activo según InitGame del log (null si desconocido)
  gametype   String?  // modo activo según InitGame (ej. "war")
  server     String?  // etiqueta de servidor si la fuente la expone
  time       DateTime
  timeEpoch  Int // epoch en segundos

  @@index([originGuid, timeEpoch])
  @@index([targetGuid, timeEpoch])
  @@index([timeEpoch])
  @@index([weapon])
  @@index([map])
}

/// Estado incremental por fuente (evita reimportar kill events ya conocidos)
model SyncState {
  id            Int       @id @default(autoincrement())
  source        String    @unique // ruta de la DB fuente
  lastKillEpoch Int       @default(0)
  lastRunAt     DateTime?
}

/// Cursor de lectura del games_mp.log del servidor dedicado IW4x.
/// El offset de bytes avanza solo cuando las líneas están completas (tolera
/// escrituras a medias y truncados/rotaciones del archivo).
model LogIngestState {
  id              Int       @id @default(autoincrement())
  source          String    @unique // ruta absoluta del games_mp.log
  byteOffset      BigInt    @default(0) // bytes ya procesados
  linesParsed     Int       @default(0) // telemetría acumulada
  linesIgnored    Int       @default(0) // líneas no reconocidas (skip silencioso)
  currentMap      String?   // estado del parser: mapa activo (última InitGame con infostring)
  currentGametype String?   // estado del parser: modo activo
  lastRunAt       DateTime?
}

/// Auditoría de sincronizaciones
model SyncRun {
  id              Int       @id @default(autoincrement())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  ok              Boolean   @default(false)
  playersSynced   Int       @default(0)
  killEventsSynced Int      @default(0)
  warnings        String?
}
