# ── API ────────────────────────────────────────────────────────
# Puerto HTTP de la API
PORT=3000
# Entorno: development | test | production
NODE_ENV=development

# ── Base de datos (Prisma + SQLite) ────────────────────────────
# Ruta relativa a apps/api/prisma/ o absoluta. Ej: "file:./dev.db"
DATABASE_URL="file:./dev.db"

# ── Auth ───────────────────────────────────────────────────────
# Secreto para firmar los JWT. OBLIGATORIO en producción (>=16 chars).
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Expiración del token (formato jsonwebtoken: "12h", "7d", ...)
JWT_EXPIRES_IN="7d"

# ── IW4MAdmin ──────────────────────────────────────────────────
# Ruta a la SQLite de IW4MAdmin. Se abre SIEMPRE en modo READ-ONLY.
# En Windows usa barras normales para evitar problemas con "\n" en paths:
IW4MADMIN_DB_PATH=
# Ejemplo IW4MAdmin real:  C:/IW4MAdmin/Database/Database.sqlite
# Ejemplo datos demo:      C:/Users/tu/Documents/GitHub/iw4x-ranking/Database/Database.sqlite

# ── Log del servidor dedicado IW4x (ingesta directa, alternativa a IW4MAdmin) ──
# Ruta del games_mp.log que escribe el server dedicado (requiere logfile 2 en su cfg).
# Soporta rutas UNC de red: '\\192.168.2.251\iw4x-logs\games_mp.log' (comillas simples
# recomendadas para UNC en .env).
GAME_LOG_PATH=
# Ejemplo local:   D:/Call of Duty 6/userraw/logs/games_mp.log
# Ejemplo remoto:  '\\192.168.2.251\iw4x-logs\games_mp.log'

# ── Ingesta LIVE de stats + anti-unlock (unlockstats) ──────────
# Snapshot que escribe el script GSC server-side del server dedicado
# (apps/api/gsc/iw4x-ranking.gsc → copiar a <raíz del juego>/userraw/scripts/;
# ver docs/SETUP.md §4H). El server lo REESCRIBE cada ~60s con las stats
# descifradas de los conectados (XP/prestigio/kills/... vía GetStat) y la API
# lo lee cada LIVE_STATS_INTERVAL_MS para el LVL en vivo y el detector
# unlockstats. Vacío = ingesta live desactivada (todo silencioso).
LIVE_STATS_FILE=
# Ejemplo local: D:/Call of Duty 6/userraw/scriptdata/iw4x-ranking.json
LIVE_STATS_INTERVAL_MS=30000
# Detector unlockstats: salto de XP > LIVE_XP_JUMP_LIMIT dentro de
# LIVE_XP_JUMP_WINDOW_MS (10 min) → suspicious. Primer avistamiento SIN
# historial con XP == 2516000 (L70 completo) → suspicious (solo alerta).
LIVE_XP_JUMP_LIMIT=500000
LIVE_XP_JUMP_WINDOW_MS=600000
# Acción contra suspicious: false = solo flag/alerta en el panel
# (GET /api/admin/server/livestats). true = tell + clientkick. Es un SETTING
# persistente (anti_unlock_autokick), cambiable en vivo vía
# POST /api/admin/server/anti-unlock — NO se configura por env.
# Mensaje del tell antes del kick (solo con autokick ON):
ANTI_UNLOCK_KICK_MSG=Stats modificados detectados
# Dirección que se guarda como servidor de los eventos/conexiones:
GAME_SERVER_ADDRESS=127.0.0.1:28961

# Intervalo de sincronización automática en minutos (0 = desactivada)
SYNC_INTERVAL_MINUTES=0
# Intervalo en SEGUNDOS (tiene prioridad sobre los minutos; ej. 30 para ingest casi en vivo)
SYNC_INTERVAL_SECONDS=0

# Ventana (en minutos) para candidatos de vinculación cuenta↔GUID
LINK_WINDOW_MINUTES=10

# ── Roles de admin ─────────────────────────────────────────────
# Emails (separados por coma) que reciben rol ADMIN automáticamente
# al registrarse o loguear (case-insensitive):
ADMIN_EMAILS=
# Ejemplo: ADMIN_EMAILS=yo@midominio.com, admin@midominio.com
# Promoción manual: npm run promote:admin -- <email>  (--demote para revertir)

# ── Admin por defecto (seed) ───────────────────────────────────
# Se auto-crea SOLO en el primer arranque si la tabla User está VACÍA
# (clonar → npm install → db push → dev:api ⇒ admin listo). Recreación manual:
# npm run seed:admin (idempotente: si ya existe, NO resetea la contraseña).
# IMPORTANTE: el login es SOLO por NICK — entra con ADMIN_NICK + ADMIN_PASSWORD.
# El email NO es credencial de acceso (solo gestión de cuenta).
# ⚠️ CAMBIA la contraseña por defecto tras el primer login.
ADMIN_NICK=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
# true (default) → auto-seed al arrancar si la DB no tiene usuarios.
# "false"/"0" lo desactiva (no afecta a npm run seed:admin).
SEED_DEFAULT_ADMIN=1

# ── Lista de servers (launcher/web sin hardcodear) ─────────────
# JSON array [{name, address, isDefault?}]. Si falta, se deriva de GAME_SERVER_ADDRESS.
SERVERS=
# Ejemplo: SERVERS=[{"name":"LAN Server","address":"192.168.2.251:28960"},{"name":"Test Local","address":"192.168.3.99:28961","isDefault":true}]

# ── Panel admin de config del server ───────────────────────────
# Ruta del server.cfg REAL del server dedicado (GET/PUT /api/admin/server-config):
SERVER_CFG_PATH=
# Ejemplo: SERVER_CFG_PATH=D:/Call of Duty 6/userraw/server.cfg
# INTERRUPTOR de seguridad: con 1 se permite reiniciar el server (PUT post-save y
# POST /api/admin/server/restart). Con 0 (default) NUNCA se ejecuta ningún comando:
ALLOW_SERVER_CONTROL=0
# Comando completo de reinicio (se ejecuta con child_process; solo si flag=1):
SERVER_RESTART_COMMAND=
# Ejemplo Windows: SERVER_RESTART_COMMAND=taskkill /F /IM iw4x.exe & timeout /t 2 & start "" "D:\Call of Duty 6\DedicatedServer.bat"

# ── CORS ───────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGIN=http://localhost:5173

# ── Cloud save de progresión (/api/profile/*) ──────────────────
# Raíz donde la API guarda los snapshots del save de juego POR CUENTA:
# <dir>/<userId>/<versionTimestamp>-<sha256>/... + <dir>/<userId>/latest.json
# Se conservan las últimas 10 versiones por cuenta (poda automática).
# Default si falta: <repo>/apps/api/storage/profiles (carpeta gitignored).
PROFILE_STORAGE_DIR=
# =====================================================================
# Bridge de moderacion IW4MAdmin (/api/admin/iam/*) - SOLO moderacion
# =====================================================================
# URL del webfront de IW4MAdmin. Deja vacio para desactivar el bridge (los
# endpoints /api/admin/iam/* devolveran 503 IAM_NOT_CONFIGURED).
# Same-host (API y IW4MAdmin en la misma maquina): desde 127.0.0.1 y SIN header
# X-Forwarded-For, el webfront otorga acceso Console sin login (no se necesita
# credencial ninguna). Ver docs/API.md - seccion "Moderacion (bridge IW4MAdmin)".
IW4MADMIN_WEBFRONT_URL=
# Ejemplo: IW4MADMIN_WEBFRONT_URL=http://127.0.0.1:1624

# SQLite de IW4MAdmin (Database.db) abierta en SOLO-LECTURA para el historial de
# penalidades (warn/kick/tempban/ban/unban) y penalidades vigentes por cliente.
# NUNCA se usa como fuente de stats del ranking: esa fuente es GAME_LOG_PATH.
IW4MADMIN_PENALTIES_DB_PATH=
# Ejemplo: IW4MADMIN_PENALTIES_DB_PATH=D:/IW4MAdmin/Database/Database.db

# Credenciales OPCIONALES de un cliente privilegiado de IW4MAdmin (Trusted+ con
# permiso para warn/kick/tempban/ban). SOLO necesarias si la API corre en un host
# DISTINTO al de IW4MAdmin: el proxy hace login por cookie (.AspNetCore.Cookies)
# con cache y re-login automatico al recibir 401. Flujo manual equivalente:
# crear la cuenta con !owner en el juego y repartir su token con !rt (docs/SETUP.md 4G).
# El password nunca se loguea ni viaja en query strings: solo en el body del login.
IW4MADMIN_API_USER=
IW4MADMIN_API_PASS=
