# ── API ────────────────────────────────────────────────────────
# Puerto HTTP de la API
PORT=3000
# Entorno: development | test | production
NODE_ENV=development

# ── Base de datos (Prisma + SQLite) ────────────────────────────
# Ruta relativa a apps/api/prisma/ o absoluta. Ej: "file:./dev.db"
DATABASE_URL="file:./dev.db"

# ── Auth ───────────────────────────────────────────────────────
# Secreto para firmar los JWT. OBLIGATORIO en producción (>=16 chars).
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Expiración del token (formato jsonwebtoken: "12h", "7d", ...)
JWT_EXPIRES_IN="7d"

# ── IW4MAdmin ──────────────────────────────────────────────────
# Ruta a la SQLite de IW4MAdmin. Se abre SIEMPRE en modo READ-ONLY.
# En Windows usa barras normales para evitar problemas con "\n" en paths:
IW4MADMIN_DB_PATH=
# Ejemplo IW4MAdmin real:  C:/IW4MAdmin/Database/Database.sqlite
# Ejemplo datos demo:      C:/Users/tu/Documents/GitHub/iw4x-ranking/Database/Database.sqlite

# Intervalo de sincronización automática en minutos (0 = desactivada)
SYNC_INTERVAL_MINUTES=0

# Ventana (en minutos) para candidatos de vinculación cuenta↔GUID
LINK_WINDOW_MINUTES=10

# ── CORS ───────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGIN=http://localhost:5173
